{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "人生规划",
  "version": "0.5.4",
  "identifier": "cn.jinshu.qizheng",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "人生规划 · 七政四余",
        "width": 1380,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#080e1d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/app.ico"
    ],
    "resources": {
      "resources/runtime/": "runtime/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
